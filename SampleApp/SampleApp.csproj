<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <Import Project="../VersionInfo.props" />

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Required. Without this the SDK never generates an import map, and there is nothing for this
         package to compute a digest from. -->
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <StaticWebAssetSpaFallbackEnabled>true</StaticWebAssetSpaFallbackEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0-preview.7.*" />
    <PackageReference Include="Toolbelt.Blazor.WebAssembly.ExtensibleGateway" Version="$(ExtensibleGatewayVersion)" PrivateAssets="all" />
    <PackageReference Include="Toolbelt.Blazor.WebAssembly.ExtensibleGateway.ImportMapExtension" Version="$(ImportMapExtensionVersion)" PrivateAssets="all" />
  </ItemGroup>

</Project>
