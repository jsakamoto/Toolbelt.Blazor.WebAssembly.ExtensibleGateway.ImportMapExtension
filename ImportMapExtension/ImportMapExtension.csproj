<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="../VersionInfo.props" />
  <Import Project="../ImportMapExtension.Shared/ImportMapExtension.Shared.projitems" Label="Shared" />

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <WarningsAsErrors>$(WarningsAsErrors);nullable</WarningsAsErrors>
    <AssemblyName>Toolbelt.Blazor.WebAssembly.ExtensibleGateway.ImportMapExtension</AssemblyName>
    <RootNamespace>Toolbelt.Blazor.WebAssembly.ExtensibleGateway.ImportMapExtension</RootNamespace>
    <Version>$(ImportMapExtensionVersion)</Version>
    <IsPackable>false</IsPackable>
    <!-- The gateway loads an extension by path and looks for that extension's own dependencies in
         the folder it sits in, so a private dependency has to be copied next to it. This extension
         happens to need nothing but the shared framework, so nothing is copied either way. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- PrivateAssets keeps this out of the "frameworkReferences" section of the .nuspec. This
         package ships a tool that the gateway loads, not a library that consumers compile
         against. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ImportMapExtension.Test" />
  </ItemGroup>

</Project>
